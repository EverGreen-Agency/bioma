{
  "name": "Univet Loupes - Stack de Automações n8n",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "cron-nomus-trigger",
      "name": "Cron Nomus Polling (15m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "={{$env.NOMUS_API_BASE_URL}}/rest/pedidos_venda",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {
          "response": {
            "response": {
              "fullResponse": false
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "FATURADO,APROVADO"
            },
            {
              "name": "data_modificacao_inicio",
              "value": "={{$now.minus({minutes: 20}).toISO()}}"
            }
          ]
        }
      },
      "id": "http-get-nomus-orders",
      "name": "Buscar Pedidos Faturados no Nomus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extrai e sanitiza os identificadores do cliente Nomus (CPF/CNPJ, Telefone e Email)\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const cliente = data.cliente || {};\n  \n  // Sanitização de telefone para formato brasileiro\n  let rawPhone = String(cliente.telefone || cliente.celular || '');\n  let digits = rawPhone.replace(/\\D/g, '');\n  if (digits.startsWith('0')) digits = digits.slice(1);\n  let cleanPhone = digits;\n  if (digits.length >= 10 && !digits.startsWith('55')) {\n    cleanPhone = '55' + digits;\n  }\n  \n  results.push({\n    json: {\n      nomus_pedido_id: data.id || data.codigo_pedido,\n      valor_total: data.valor_total || 0,\n      data_faturamento: data.data_faturamento || new Date().toISOString(),\n      numero_nfe: data.numero_nfe || '',\n      cliente_nome: cliente.razao_social || cliente.nome,\n      cliente_cpf_cnpj: (cliente.cnpj_cpf || '').replace(/\\D/g, ''),\n      cliente_telefone: cleanPhone,\n      cliente_email: (cliente.email || '').trim().toLowerCase(),\n      produtos: (data.itens || []).map(i => i.descricao || i.nome_produto).join(', ')\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "code-sanitize-nomus",
      "name": "Sanitizar Dados do Pedido Nomus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{$env.KOMMO_BASE_URL}}/api/v4/contacts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{$json.cliente_telefone || $json.cliente_email || $json.cliente_cpf_cnpj}}"
            },
            {
              "name": "with",
              "value": "leads"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.KOMMO_ACCESS_TOKEN}}"
            }
          ]
        }
      },
      "id": "http-search-kommo-contact",
      "name": "Buscar Contato no Kommo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.KOMMO_BASE_URL}}/api/v4/leads/{{$json.target_lead_id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.KOMMO_ACCESS_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "status_id",
              "value": "={{$env.KOMMO_STATUS_ID_VENDA_GANHA}}"
            },
            {
              "name": "price",
              "value": "={{$json.valor_total}}"
            }
          ]
        }
      },
      "id": "http-update-kommo-lead",
      "name": "Atualizar Lead no Kommo para Ganho",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BIOMA_API_BASE_URL}}/workspaces/{{$env.UNIVET_WORKSPACE_ID}}/integrations/sales_event",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.BIOMA_INTEGRATION_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source\": \"nomus_erp\",\n  \"event_type\": \"order_invoiced\",\n  \"external_order_id\": \"{{$json.nomus_pedido_id}}\",\n  \"amount_cents\": Math.round({{$json.valor_total}} * 100),\n  \"customer_name\": \"{{$json.cliente_nome}}\",\n  \"customer_phone\": \"{{$json.cliente_telefone}}\",\n  \"customer_email\": \"{{$json.cliente_email}}\",\n  \"products\": \"{{$json.produtos}}\",\n  \"timestamp\": \"{{$json.data_faturamento}}\"\n}"
      },
      "id": "http-notify-bioma-bi",
      "name": "Notificar Bioma Cockpit (BI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "univet/lead-intake",
        "responseMode": "onReceived",
        "responseData": "OK"
      },
      "id": "webhook-univet-form-whatsapp",
      "name": "Webhook Ingestão (Site / WhatsApp Univet)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 560]
    },
    {
      "parameters": {
        "jsCode": "// Normalização preventiva de Telefone e E-mail para impedir criação de duplicatas\nconst item = $input.item.json;\nlet phone = String(item.phone || item.telefone || item.whatsapp || '');\nlet digits = phone.replace(/\\D/g, '');\nif (digits.startsWith('0')) digits = digits.slice(1);\n\nlet canonicalPhone = digits;\nlet matchKey = digits;\nif (digits.startsWith('55') && digits.length >= 12) {\n  const ddd = digits.slice(2, 4);\n  const num = digits.slice(4);\n  canonicalPhone = `+55${ddd}${num}`;\n  matchKey = num.length === 9 && num.startsWith('9') ? `br_${ddd}_${num.slice(1)}` : `br_${ddd}_${num}`;\n} else if (digits.length >= 10) {\n  const ddd = digits.slice(0, 2);\n  const num = digits.slice(2);\n  canonicalPhone = `+55${ddd}${num}`;\n  matchKey = num.length === 9 && num.startsWith('9') ? `br_${ddd}_${num.slice(1)}` : `br_${ddd}_${num}`;\n}\n\nreturn {\n  json: {\n    raw: item,\n    name: (item.name || item.nome || 'Lead Univet').trim(),\n    email: (item.email || '').trim().toLowerCase(),\n    canonical_phone: canonicalPhone,\n    match_key: matchKey,\n    utm_source: item.utm_source || 'direct',\n    utm_campaign: item.utm_campaign || '',\n    especialidade: item.especialidade || item.specialty || 'Não informada',\n    produto_interesse: item.produto_interesse || item.product || 'Lupa Ergonômica'\n  }\n};"
      },
      "id": "code-precheck-sanitize",
      "name": "Pre-Check Normalizer",
      "type": "n8n-nodes-base.code",
