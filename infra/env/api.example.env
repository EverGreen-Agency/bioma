APP_ENV=local
API_NAME=Bioma API
DATABASE_URL=postgresql://bioma:bioma@localhost:5433/bioma
SESSION_COOKIE_NAME=bioma_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
# Só usado por scripts/seed_dev.py — recusa rodar fora de local sem isto.
ALLOW_DEV_SEED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.evergreenmkt.com.br,https://evergreenmkt.com.br
# Janela de rate limit de login (services/rate_limit.py, guardado em Postgres).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# OAuth Google (AUTH-003): credenciais do Google Cloud Console (tipo Web).
# redirect_uri autorizado = {API_PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
API_PUBLIC_URL=http://127.0.0.1:8000
WEB_APP_URL=http://localhost:5173
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_MB=20
# Cifra de segredos de integração em repouso (Kommo etc.). Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem isto, a API recusa guardar segredo de integração (503 controlado) em vez
# de gravar em texto puro — configure antes de qualquer integração de cliente.
SECRET_ENCRYPTION_KEY=
# Necessário só para renovar tokens Kommo expirados (mesmo redirect da integração)
KOMMO_REDIRECT_URI=
# GitHub Tech (leitura de issues/PRs e criação de issue por entrega).
GITHUB_API_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
# Benchmark de concorrentes (Ahrefs API v3) — contexto de mercado em roteiros,
# nunca fabricado sem a chave.
AHREFS_API_KEY=
# OAuth por conexão (TikTok/LinkedIn não têm credencial única compartilhada
# como o Google — cada cliente autoriza individualmente).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Chave de bootstrap do primeiro admin EG em staging/produção (scripts/bootstrap_admin.py).
# Não é lida pelo Settings — só pelo próprio script, uma vez por ambiente.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Domínios aceitos ao convidar alguém para o time da EG. Vazio = sem restrição.
# É guarda-corpo contra e-mail digitado errado, NÃO autenticação: quem decide
# privilégio é o papel (`eg_admin` / `eg_member`), nunca o domínio.
EG_INVITE_ALLOWED_DOMAINS=evergreenmkt.com.br,evergreengrowth.com.br
