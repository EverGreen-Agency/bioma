DATABASE_URL=postgresql://bioma:bioma@localhost:5433/bioma
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21
GOOGLE_REQUEST_TIMEOUT_SECONDS=60
META_ADS_ACCESS_TOKEN=
META_ADS_API_VERSION=v21.0
LINKEDIN_ADS_ACCESS_TOKEN=
LINKEDIN_ADS_API_VERSION=202504
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v21.0
INSTAGRAM_POST_SYNC_LIMIT=50
YOUTUBE_API_KEY=
YOUTUBE_ORGANIC_SYNC_LIMIT=50
# Radar Local (prospecção de negócios via Google Places).
GOOGLE_PLACES_API_KEY=
# Cifra de segredos em repouso — mesma chave da API (SECRET_ENCRYPTION_KEY em
# bioma/infra/env/api.example.env). Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
# OAuth por conexão (TikTok/LinkedIn não têm credencial única compartilhada
# como o Google — cada cliente autoriza individualmente).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# OpenAI: prévia local do copiloto de vendas, tradução de propostas,
# transcrição de áudio (Whisper) e pesquisa de plataformas. Sem chave, cada
# feature falha alto ou cai em prévia rotulada — nunca inventa conteúdo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_REQUEST_TIMEOUT_SECONDS=120
CODEX_CLI_PATH=codex
CLAUDE_CLI_PATH=claude
AI_EXECUTION_TIMEOUT_SECONDS=600
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Benchmark de concorrentes (Ahrefs API v3) e importação de reuniões (Fathom).
AHREFS_API_KEY=
FATHOM_API_KEY=
FATHOM_REQUEST_TIMEOUT_SECONDS=60
# QUEUE-001: lease do job na fila (sync_runs) e tentativas antes de desistir.
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3
