{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--config", "infra/mcp/playwright.config.json"]
    },
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "n8n": {
      "command": "python",
      "args": ["infra/mcp/n8n_mcp_server.py"],
      "env": {
        "N8N_API_URL": "http://localhost:5678",
        "N8N_API_KEY": ""
      }
    }
  }
}
